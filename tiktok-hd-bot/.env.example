# Salin fail ini ke .env dan ubah ikut keperluan.

# Nombor WhatsApp bot (format antarabangsa, tanpa +). Isi untuk log masuk guna KOD PAIRING.
# Biarkan kosong untuk log masuk guna QR di terminal.
BOT_NUMBER=

# Awalan arahan, contoh .max / .hd / .info
PREFIX=.

# Nombor pemilik (boleh lebih dari satu, pisah dengan koma)
OWNER_NUMBER=

# Hadkan siapa boleh guna bot (kosong = semua orang). Contoh: 60123456789,60198765432
ALLOWED_NUMBERS=

# Benarkan bot dalam group (hanya balas arahan, tidak auto-proses)
ALLOW_GROUPS=false

# Proses terus video yang dihantar di chat peribadi tanpa perlu arahan
AUTO_PROCESS=true

# Mod lalai: max (4K 2160p) | hd (1080p) | keep (resolusi asal)
DEFAULT_MODE=max
DEFAULT_FPS=30

# Preset x264: veryfast / faster / fast / medium / slow  (lebih perlahan = lebih tajam)
X264_PRESET=medium
CRF=17

# Had fail
MAX_FILE_MB=1024
MAX_DURATION_SEC=300

# Teks tag encoder (©too) dalam fail hasil
ENCODER_TAG=TikTok HD Bot

# Berapa video diproses serentak (CPU berat — biasanya 1)
CONCURRENCY=1

# Folder sesi WhatsApp dan folder kerja sementara
SESSION_DIR=session
WORK_DIR=tmp

# Log dalaman Baileys: silent / warn / info / debug
LOG_LEVEL=silent

# Laluan ffmpeg/ffprobe jika bukan dalam PATH
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
