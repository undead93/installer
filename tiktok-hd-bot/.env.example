# Salin fail ini ke .env dan ubah ikut keperluan.

# Nombor WhatsApp bot (format antarabangsa, tanpa +). Isi untuk log masuk guna KOD PAIRING.
# Biarkan kosong untuk log masuk guna QR di terminal.
BOT_NUMBER=

# Awalan arahan, contoh .max / .hd / .info
PREFIX=.

# Nombor pemilik (boleh lebih dari satu, pisah dengan koma)
OWNER_NUMBER=

# Hadkan siapa boleh guna bot (kosong = semua orang). Contoh: 60123456789,60198765432
ALLOWED_NUMBERS=

# Di mana bot layan: group (lalai) | private | all
REPLY_IN=group

# (Pilihan) hadkan bot kepada group tertentu sahaja. Hantar .id dalam group untuk dapat ID-nya.
# Contoh: GROUP_IDS=120363012345678901@g.us,120363098765432109@g.us
GROUP_IDS=

# Benarkan nombor bot sendiri guna arahan (berguna kalau bot guna nombor peribadi:
# hantar dokumen dengan kapsyen .max dari telefon bot)
ALLOW_SELF=true

# Dokumen video terus di-convert tanpa perlu taip arahan
AUTO_PROCESS=true

# Kaedah: tt (lalai) = video asal disalin tanpa encode semula + format eksport editor TikTok
#         (tag te_is_reencode/copyright, audio pendua + 17 frame senyap) — macam fail rujukan
#         haze = encode semula SDR H.264 4K dalam bekas gaya iPhone (kaedah lama, arahan .max/.hd)
METHOD=tt
META_ARTIST=HD Method
META_COMMENT=normal

# (kaedah haze) Gaya bekas: haze (susun atur penuh fail Haze: trek AAC pendua + 17 frame senyap — lalai) | clean
OUTPUT_STYLE=haze

# Sambungan fail balasan: mp4 (lalai) | mov
DOC_FORMAT=mp4

# MIME dokumen balasan: octet (fail biasa — iPhone boleh muat turun, lalai) | video
# (video/mp4 gagal dimuat turun di WhatsApp iPhone — guna arahan .uji untuk uji pilihan lain)
DOC_MIME=octet

# Mod lalai: max (4K 2160p) | hd (1080p) | keep (resolusi asal)
DEFAULT_MODE=max
DEFAULT_FPS=30

# Preset x264: veryfast / faster / fast / medium / slow  (lebih perlahan = lebih tajam)
X264_PRESET=medium
CRF=16

# Had fail
MAX_FILE_MB=1024
MAX_DURATION_SEC=300

# Teks tag encoder (©too) dalam fail hasil
ENCODER_TAG=HD Method

# Berapa video diproses serentak (CPU berat — biasanya 1)
CONCURRENCY=1

# Folder sesi WhatsApp dan folder kerja sementara
SESSION_DIR=session
WORK_DIR=tmp

# Log dalaman Baileys: silent / warn / info / debug
LOG_LEVEL=silent

# Laluan ffmpeg/ffprobe jika bukan dalam PATH
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
