# ===== WhatsApp =====
# Nombor yang akan TERIMA alert & boleh hantar arahan (format antarabangsa, tanpa + atau 0 depan).
# Boleh letak lebih dari satu, pisah dengan koma. Contoh: 60123456789,60198765432
# Kalau kosong, bot hantar ke chat "Message yourself" akaun bot sendiri.
OWNER_NUMBERS=60123456789

# (Pilihan) Login guna pairing code instead of scan QR.
# Isi nombor akaun WhatsApp yang jadi BOT. Kosongkan untuk guna QR.
PAIRING_NUMBER=

# ===== Bybit =====
SYMBOL=PAXGUSDT
# linear = USDT perpetual futures
CATEGORY=linear
BYBIT_BASE_URL=https://api.bybit.com

# ===== Alert =====
# Saiz 1 pip. Untuk emas/PAXG biasanya 1 pip = 0.1 (jadi 100 pip = $10).
# Kalau anda kira 1 pip = 0.01, tukar ke 0.01 (100 pip = $1).
PIP_SIZE=0.1
# Jarak default bila guna "set <harga>" tanpa nombor pip
DEFAULT_PIPS=100
# Selang semak harga (saat)
POLL_SECONDS=5

# ===== Trend / EMA =====
EMA_PERIODS=7,14,28
TIMEFRAMES=15,30,60,240

# ===== Lain-lain =====
TIMEZONE=Asia/Kuala_Lumpur
