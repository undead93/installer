# ===== WhatsApp =====
# Nombor yang BOLEH guna bot (nombor utama anda). Format: 60123456789 (tanpa +). Pisah dengan koma kalau lebih dari satu.
ALLOWED_NUMBERS=60123456789

# (Pilihan) Nombor WhatsApp BOT. Kalau diisi, bot bagi "pairing code" (tak perlu scan QR).
# Kosongkan kalau nak guna QR.
WA_PAIRING_NUMBER=

# ===== TikTok for Developers =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Mesti SAMA PERSIS dengan Redirect URI yang didaftar dalam app TikTok (https)
TIKTOK_REDIRECT_URI=https://username-anda.github.io/

# direct = terus post | draft = hantar ke inbox TikTok, anda tekan Post sendiri dalam app
TIKTOK_MODE=direct
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
# App yang belum lulus audit TikTok hanya boleh SELF_ONLY
TIKTOK_PRIVACY=SELF_ONLY

# ===== Video =====
# Tukar video >60fps (cth 120fps) ke 60fps sebelum upload (TikTok maks 60fps)
AUTO_CONVERT_60FPS=true
# Kualiti encode bila tukar fps: 14-20 (kecil = lebih cantik)
FFMPEG_CRF=16
# ultrafast | fast | medium | slow (slow = lebih cantik tapi lambat)
FFMPEG_PRESET=slow

# Folder simpan sesi WhatsApp, token TikTok & fail sementara
DATA_DIR=./data
LOG_LEVEL=warn
