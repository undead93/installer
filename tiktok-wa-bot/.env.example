# ===== WhatsApp =====
# Nombor yang BOLEH guna bot (nombor utama anda). Format: 60123456789 (tanpa +). Pisah dengan koma kalau lebih dari satu.
ALLOWED_NUMBERS=60123456789

# --- Kalau nombor WhatsApp yang sama dah ada bot lain ---
# SELF_CHAT=true: link bot ni ke nombor ANDA SENDIRI dan guna chat "Message yourself".
#   Bot hanya baca mesej yang anda hantar kepada diri sendiri, jadi tak perlu nombor kedua dan tak kacau bot lain.
#   (ALLOWED_NUMBERS tak diperlukan dalam mod ini; WA_PAIRING_NUMBER = nombor anda sendiri)
SELF_CHAT=false
# Awalan arahan. Tukar kalau bot lain pun guna "!". Contoh: COMMAND_PREFIX=tt  →  "tt semak", "tt sessionid ..."
COMMAND_PREFIX=!
# Kalau diisi, video hanya diproses bila caption bermula dengan perkataan ini. Contoh: VIDEO_TRIGGER=tt
#   → caption "tt Video best #fyp" akan dipost sebagai "Video best #fyp". Video tanpa "tt" diabaikan.
VIDEO_TRIGGER=

# (Pilihan) Nombor WhatsApp BOT. Kalau diisi, bot bagi "pairing code" (tak perlu scan QR).
# Kosongkan kalau nak guna QR.
WA_PAIRING_NUMBER=

# ===== Kaedah upload TikTok =====
# web = bot buka tiktok.com guna browser automatik (tak perlu akaun developer, boleh terus public)
# api = TikTok Content Posting API rasmi (perlu app TikTok for Developers, isi key di bawah)
TIKTOK_METHOD=web

# --- Untuk kaedah web ---
# true = browser tanpa skrin (biasa untuk VPS). false = perlu xvfb (lihat README)
BROWSER_HEADLESS=true
# Berapa minit maksimum tunggu upload siap
UPLOAD_TIMEOUT_MIN=15

# ===== TikTok for Developers (untuk kaedah api sahaja) =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Mesti SAMA PERSIS dengan Redirect URI yang didaftar dalam app TikTok (https)
TIKTOK_REDIRECT_URI=https://username-anda.github.io/

# direct = terus post | draft = hantar ke inbox TikTok, anda tekan Post sendiri dalam app
TIKTOK_MODE=direct
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
# App yang belum lulus audit TikTok hanya boleh SELF_ONLY
TIKTOK_PRIVACY=SELF_ONLY

# ===== Video =====
# Optimumkan video sebelum upload: tukar HEVC/HDR/4K (cth dari iPhone) ke H.264 1080p SDR,
# tambah trek audio senyap kalau tiada. Fail yang dah H.264 1080p SDR tak diencode semula.
OPTIMIZE_VIDEO=true
# Siling bitrate bila encode semula (Mbps). 8–12 biasanya terbaik untuk TikTok
MAX_BITRATE_MBPS=12
# Tukar video >60fps (cth 120fps) ke 60fps sebelum upload (TikTok maks 60fps)
AUTO_CONVERT_60FPS=true
# Kualiti encode bila tukar fps: 14-20 (kecil = lebih cantik)
FFMPEG_CRF=17
# ultrafast | fast | medium | slow (slow = lebih cantik tapi lambat)
FFMPEG_PRESET=slow

# Folder simpan sesi WhatsApp, token TikTok & fail sementara
DATA_DIR=./data
LOG_LEVEL=warn
